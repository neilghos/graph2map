# Ignore everything by default
*

# Whitelist directories so Git can recurse into subdirectories
!*/

# Whitelist .gitignore
!.gitignore

# Whitelist all Python source files
!*.py
!**/*.py

# Explicit exclusions for caches, temporary datasets, and compiled artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pt
*.pth
*.pkl
cache/
**/cache/
datasets/
**/datasets/
check_point/
**/check_point/
Log_Info/
**/Log_Info/
.venv/
env/
.vscode/
.idea/
